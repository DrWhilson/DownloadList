{
  "position": "top",
  "output": [
    "HDMI-A-1",
    "Unknown-1"
  ],
    "margin-top" : 0,
    "margin-left": 10,
    "margin-right": 10,
    "height" : 28,
    "modules-left": [
      "custom/appmenuicon",
      "hyprland/workspaces",
      "custom/usb",
      "hyprland/window"
    ],
    "modules-center": [
    "cpu",
    "memory",
    "custom/gpu"
    ],
    "modules-right": [
    "hyprland/language",
    "custom/brightness-toggle",
    "pulseaudio",
    "battery",
    "disk",
    "network",
    "clock",
    "custom/powermenu"
    ],
    "hyprland/window": {
      "format": "{}",
      "max-length": 35,
      "rewrite": {
        "": "Hyprland"
      },
      "separate-outputs": true
    },
    "custom/appmenuicon": {
        "format": " ",
        "on-click": "mate-terminal -e \"bash -c 'neofetch; exec zsh'\"",
        // "on-click-right": "~/dotfiles/hypr/scripts/keybindings.sh",
        "tooltip": false
    },
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "format-icons": {
        "active": ""
      },
      "sort-by-number": true,
      "all-outputs": true,
      "persistent-workspaces": {
        "*": 2
      }
    },
    "clock": {
      "format": "  {:%H:%M}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "  {:%Y-%m-%d}"
    },
    "keyboard-state": {
      "numlock": false,
      "capslock": false,
      "format": "{name}",
      "format-icons": {
        "en": "US",
        "ru": "RU",
        "ua": "UA"
      }
    },
    "cpu": {
      "format": "󰍛 {usage}%",
      "tooltip": false,
      "on-click": "nohup mate-terminal -- btop"
    },
    "memory": {
      "format": "󰫗 {}%"
    },
    "custom/gpu": {
      "format": "󰾲 {}%",
      "interval": 2,
      "exec": "~/.config/waybar/scripts/gpu-usage.sh",
      "return-type": "json",
      "on-click": "mate-terminal -e \"bash -c 'nvidia-smi; exec zsh'\""
    },
    "temperature": {
      "critical-threshold": 80,
      "format": "{icon} {temperatureC}°C",
      "format-icons": ["", "", ""]
    },
    "custom/brightness-toggle": {
      "exec": "~/.config/waybar/scripts/brightness-toggle.sh",
      "return-type": "json",
      "format": "{}",
      "on-click": "~/.config/waybar/scripts/brightness-toggle.sh click left",
      "on-click-right": "~/.config/waybar/scripts/brightness-toggle.sh click right",
      "tooltip": false,
      "signal": 2 
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon}  {capacity}%",
      "format-full": "{icon}  {capacity}%",
      "format-charging": "  {capacity}%",
      "format-plugged": "  {capacity}%",
      "format-alt": "{time} {icon}",
      "format-icons": ["", "", "", "", ""]
    },
    "network": {
      "format-wifi": "  {signalStrength}%",
      "format-ethernet": "󰈁",
      "tooltip-format": "{ifname} via {gwaddr} 󰈁",
      "format-linked": "{ifname} (No IP) 󰈁",
      "format-disconnected": "󰈂 ",
      "format-alt": "󰈁 ↓ {bandwidthDownBytes} ↑ {bandwidthUpBytes}",
      "interval": 2
    },
    "pulseaudio": {
      "format": "{icon}  {volume}%",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": " {icon} {format_source}",
      "format-muted": " {format_source}",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
      },
      "on-click": "pavucontrol"
    },
    "disk": {
      "interval": 30,
      "path": "/",
      "format": "  {percentage_used}%",
      "tooltip-format": "{used} из {total} занято на {path} ({percentage_used}%)",
      "on-click": "mate-terminal -e \"bash -c 'gdu; exec zsh'\"",
      "on-click-right": "mate-terminal -e \"bash -c 'gdu /; exec zsh'\""
    },
    "custom/usb": {
    "exec": "~/.config/waybar/scripts/usb-mount.sh",
    "format": "{}", 
    "return-type": "json",
    "interval": 3,
    "signal": 5,
    "on-click": "mate-terminal -e \"bash -c 'lsblk; exec zsh'\""
    // "on-click": "~/.config/waybar/scripts/usb-connect.sh",
    // "on-click-right": "sudo umount /dev/sde1"
    // "on-click": "mate-terminal -e \"bash -c 'cd /mnt/flash_folder; exec zsh'\""
    },
    "custom/powermenu": {
      "format": "󰐥   ",
      "tooltip": false,
      "on-click": "exec wlogout -p layer-shell"
  }
}
